{
 "info": {
  "name": "CoroVision AI API checks",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Sanitized smoke and access checks. Set baseUrl, email and password to a demo or test account. No real credentials are stored."
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://127.0.0.1:8000"
  },
  {
   "key": "email",
   "value": ""
  },
  {
   "key": "password",
   "value": ""
  },
  {
   "key": "token",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "Health",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('status 200',()=>pm.response.to.have.status(200));",
       "pm.test('status ok',()=>pm.expect(pm.response.json().status).to.eql('ok'));"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{baseUrl}}/api/health",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "health"
     ]
    },
    "auth": {
     "type": "noauth"
    }
   }
  },
  {
   "name": "Liveness",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('status 200',()=>pm.response.to.have.status(200));"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{baseUrl}}/api/health/live",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "health",
      "live"
     ]
    },
    "auth": {
     "type": "noauth"
    }
   }
  },
  {
   "name": "Readiness",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('status 200',()=>pm.response.to.have.status(200));",
       "pm.test('research only',()=>pm.expect(pm.response.json().research_only).to.eql(true));"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{baseUrl}}/api/health/ready",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "health",
      "ready"
     ]
    },
    "auth": {
     "type": "noauth"
    }
   }
  },
  {
   "name": "Sign in (demo account)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('status 200',()=>pm.response.to.have.status(200));",
       "pm.collectionVariables.set('token',pm.response.json().access_token);"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{baseUrl}}/api/auth/login",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "auth",
      "login"
     ]
    },
    "auth": {
     "type": "noauth"
    },
    "body": {
     "mode": "raw",
     "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
    }
   }
  },
  {
   "name": "Current user",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('status 200',()=>pm.response.to.have.status(200));"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [],
    "url": {
     "raw": "{{baseUrl}}/api/auth/me",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "auth",
      "me"
     ]
    },
    "auth": {
     "type": "bearer",
     "bearer": [
      {
       "key": "token",
       "value": "{{token}}",
       "type": "string"
      }
     ]
    }
   }
  },
  {
   "name": "Wrong password is refused",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('rejected',()=>pm.expect(pm.response.code).to.be.oneOf([400,401,429]));"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{baseUrl}}/api/auth/login",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "auth",
      "login"
     ]
    },
    "auth": {
     "type": "noauth"
    },
    "body": {
     "mode": "raw",
     "raw": "{\"email\": \"{{email}}\", \"password\": \"definitely-wrong-password\"}"
    }
   }
  },
  {
   "name": "Over-long password is refused, not a 500",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('no server error',()=>pm.expect(pm.response.code).to.be.below(500));"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": {
     "raw": "{{baseUrl}}/api/auth/login",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "auth",
      "login"
     ]
    },
    "auth": {
     "type": "noauth"
    },
    "body": {
     "mode": "raw",
     "raw": "{\"email\": \"{{email}}\", \"password\": \"\"}"
    }
   }
  },
